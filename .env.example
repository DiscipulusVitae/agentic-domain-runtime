# Local reviewer sandbox profile.
# No Telegram token, production Supabase project, Render service, or live LLM key is required.

APP_ENV="sandbox"
ADR_LLM_PROVIDER="fake"
ENABLED_DOMAINS="kitchen,books,medical"

# Default public reviewer storage mode.
KITCHEN_STORAGE_BACKEND="in_memory"
BOOKS_STORAGE_BACKEND="in_memory"
MEDICAL_STORAGE_BACKEND="in_memory"

# Optional local PostgreSQL/Supabase-compatible profile.
# Fill these only when running local DB integration checks.
# SUPABASE_URL="http://127.0.0.1:54321"
# SUPABASE_API_KEY_SECRET="local-service-role-placeholder"
# SUPABASE_API_KEY_PUBLISHABLE="local-anon-placeholder"

# Optional OpenAI-compatible LLM provider configuration.
# The default reviewer path must work without these values.
# To try a real provider manually, set ADR_LLM_PROVIDER to "openai_compatible".
# ADR_LLM_PROVIDER="openai_compatible"
# ADR_LLM_MODELS="kilo/stepfun/step-3.7-flash:free,kilo/poolside/laguna-m.1:free"
# OPENAI_COMPATIBLE_BASE_URL="https://api.kilo.ai/api/gateway"
# OPENAI_COMPATIBLE_API_KEY=""
